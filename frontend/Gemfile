# fastlane, for the signed iOS builds mobile-release.yml uploads to TestFlight. Pinned exactly so a
# release is reproducible; bump deliberately. Gemfile.lock came from the first release run (nothing
# here can run Ruby); after a bump, commit the lock the next run uploads as its gemfile-lock artifact
# (docs/architecture/native-apps.md, "Releasing").
source "https://rubygems.org"

gem "fastlane", "2.240.1"
