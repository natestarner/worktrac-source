# fastlane, for the signed iOS builds mobile-release.yml uploads to TestFlight. Pinned exactly so a
# release is reproducible; bump deliberately. There is no Gemfile.lock yet because nothing here can
# run Ruby -- the first release run resolves it, and that lock should be committed from the run's
# artifact (docs/architecture/native-apps.md, "Releasing").
source "https://rubygems.org"

gem "fastlane", "2.240.1"
