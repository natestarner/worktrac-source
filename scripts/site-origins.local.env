# Origins for a LOCAL preview: the marketing site served from a filled copy on :8099 (as CI's
# marketing-ci does) and the primary worktree's app on :3000. Deployed environments keep their own
# in worktrac-deploy's config/<env>/site-origins.env. See scripts/fill-site-origins.sh.
SITE_ORIGIN=http://localhost:8099
APP_ORIGIN=http://localhost:3000
# A local preview is never meant to be indexed.
SITE_ROBOTS=noindex, nofollow
