# scripts/worktree-env.sh auto-generates a real `.env.worktree` (gitignored) the first time
# you run scripts/up.sh (or any other scripts/*.sh) in a non-main worktree. This file just
# documents the shape -- you never need to create or edit `.env.worktree` by hand.
#
# WORKTREE_SLUG=my_feature_branch
# BACKEND_PORT=8081
# FRONTEND_PORT=3001
